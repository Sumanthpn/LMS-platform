# MongoDB connection string.
# Local install:  mongodb://localhost:27017
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=lms_platform

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Questions drawn per exam session.
EXAM_MIN_QUESTIONS=5
EXAM_MAX_QUESTIONS=10
